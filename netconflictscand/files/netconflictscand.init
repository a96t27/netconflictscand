#!/bin/sh /etc/rc.common

USE_PROCD=1
START=100

start_service() {
                procd_open_instance
                procd_set_param command /usr/bin/netconflictscand
                procd_set_param pidfile /var/run/netconflictscand.pid
                procd_close_instance
}

reload_service() {
	stop
	start
}